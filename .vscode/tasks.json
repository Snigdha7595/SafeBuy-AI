{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend: create venv + install", "type": "shell",
      "command": "python -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "windows": { "command": "python -m venv .venv; .venv\\Scripts\\pip install -r requirements.txt" },
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Frontend: npm install", "type": "shell", "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Backend: run (port 8000)", "type": "shell", "isBackground": true,
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Frontend: run (port 5173)", "type": "shell", "isBackground": true, "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Run everything", "dependsOn": ["Backend: run (port 8000)", "Frontend: run (port 5173)"], "dependsOrder": "parallel", "problemMatcher": [] },
    { "label": "Test: backend", "type": "shell", "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" }, "group": "test", "problemMatcher": [] },
    { "label": "Test: frontend", "type": "shell", "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "group": "test", "problemMatcher": [] }
  ]
}
